# Maintainer: Cristian Moraru <info@thekrystalship.com>
#
# Build from this directory:  cd packaging && makepkg
#
# The Control Panel SPA — a built bundle of static files. Nothing here executes on the host; it is
# served by kgsm-api, same-origin, so the panel and the API it talks to are one address.
#
# It is its own package rather than part of kgsm-api so the panel upgrades without rebuilding the
# API, each repo's version means what it says, and a node can run the API headless by simply not
# installing this.
#
# The API's web root is pointed here (/usr/share/kgsm-web) by a systemd drop-in this package ships
# for kgsm-api's unit. Installing these files into the API's own prefix instead would mean two
# packages owning one path, which pacman refuses.

pkgname=kgsm-web
pkgver=1.156.1
pkgrel=1
pkgdesc="KGSM Control Panel — the web UI served by kgsm-api"
arch=('any')
url="https://github.com/TheKrystalShip/kgsm-web"
license=('GPL-3.0-or-later')
groups=('kgsm-node')
# No separate debug package: these are shipped to a private fleet, not a distro archive.
options=('!debug')
depends=()
optdepends=('kgsm-api: serves this bundle and answers every call it makes')

_stage() { printf '%s' "${KGSM_STAGE:-${startdir}/../dist}"; }

pkgver() {
    "${startdir}/../deploy/version.sh" --pkgver
}

build() {
    local stage; stage="$(_stage)"
    [[ -f "${stage}/index.html" ]] || {
        printf '\n  no built bundle at %s\n' "$stage" >&2
        printf '  build it first:  VITE_API_BASE=self npm run build\n' >&2
        printf '  or point KGSM_STAGE at an existing dist/.\n\n' >&2
        return 1
    }
}

package() {
    local stage; stage="$(_stage)"
    local root="${pkgdir}/usr/share/${pkgname}"

    # VITE_API_BASE=self is what makes the bundle talk to whatever origin served it, so one build
    # works on every host and no domain is baked in.
    install -dm755 "$root"
    cp -a "${stage}/." "${root}/"
    find "$root" -type f -exec chmod 0644 {} +
    find "$root" -type d -exec chmod 0755 {} +

    # Point kgsm-api's web root at this bundle. ASPNETCORE_WEBROOT is the standard host-configuration
    # key behind IWebHostEnvironment.WebRootPath, which is what the API's same-origin SPA delivery
    # gates on and serves from — so the panel is reached with no code in the API naming this path.
    #
    # The drop-in belongs to THIS package: it is only ever correct while these files exist. ASP.NET
    # creates a missing web root at startup, which the service user could not do under /usr/share, so
    # a drop-in outliving the bundle would take the API down rather than merely serve no panel.
    install -Dm644 /dev/stdin \
        "${pkgdir}/usr/lib/systemd/system/kgsm-api.service.d/50-${pkgname}.conf" <<DROPIN
[Service]
Environment=ASPNETCORE_WEBROOT=/usr/share/${pkgname}
DROPIN

    install -Dm644 "${startdir}/../LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
